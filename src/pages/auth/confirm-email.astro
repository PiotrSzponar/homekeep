---
import { CheckCircle2Icon, MailCheckIcon } from "lucide-react";
import AppShell from "@/components/AppShell.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      Icon: CheckCircle2Icon,
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      Icon: MailCheckIcon,
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };

const Icon = content.Icon;
---

<Layout title={content.heading}>
  <AppShell mainClass="min-h-[calc(100vh-4rem)] items-center justify-center py-10">
    <Card className="w-full max-w-sm">
      <CardHeader className="items-center text-center">
        <Icon aria-hidden="true" className="text-primary mb-2" />
        <CardTitle>{content.heading}</CardTitle>
        <CardDescription>{content.description}</CardDescription>
      </CardHeader>
      <CardFooter className="justify-center">
        <a href="/auth/signin" class:list={[buttonVariants({ variant: "outline", size: "sm" })]}>
          {content.linkText}
        </a>
      </CardFooter>
    </Card>
  </AppShell>
</Layout>

---
import AppShell from "@/components/AppShell.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { shouldRedirectAuthPageToDashboard } from "@/lib/auth-navigation";

const error = Astro.url.searchParams.get("error");

function redirect(path: string) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", path);
}

const shouldRedirect = shouldRedirectAuthPageToDashboard(Astro.locals.user);

if (shouldRedirect) {
  redirect("/dashboard");
}
---

{
  !shouldRedirect && (
    <Layout title="Sign up">
      <AppShell mainClass="min-h-[calc(100vh-4rem)] items-center justify-center py-10">
        <Card className="w-full max-w-sm">
          <CardHeader>
            <CardTitle>Create account</CardTitle>
            <CardDescription>Start tracking recurring home maintenance.</CardDescription>
          </CardHeader>
          <CardContent>
            <SignUpForm serverError={error} client:load />
          </CardContent>
          <CardFooter className="justify-center">
            <p class="text-muted-foreground text-center text-sm">
              Already have an account?
              <a href="/auth/signin" class:list={[buttonVariants({ variant: "link", size: "sm" })]}>
                Sign in
              </a>
            </p>
          </CardFooter>
        </Card>
      </AppShell>
    </Layout>
  )
}

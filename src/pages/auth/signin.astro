---
import AppBrand from "@/components/brand/AppBrand.astro";
import SignInForm from "@/components/auth/SignInForm";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <main class="bg-background text-foreground flex min-h-screen items-center justify-center px-4 py-10">
    <div class="flex w-full max-w-sm flex-col gap-6">
      <AppBrand />

      <Card>
        <CardHeader>
          <CardTitle>Sign in</CardTitle>
          <CardDescription>Open your maintenance dashboard.</CardDescription>
        </CardHeader>
        <CardContent>
          <SignInForm serverError={error} client:load />
        </CardContent>
        <CardFooter className="justify-center">
          <p class="text-muted-foreground text-center text-sm">
            Don't have an account?
            <a href="/auth/signup" class:list={[buttonVariants({ variant: "link", size: "sm" })]}>Sign up</a>
          </p>
        </CardFooter>
      </Card>
    </div>
  </main>
</Layout>

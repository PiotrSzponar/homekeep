---
import Welcome from "@/components/Welcome.astro";
import Layout from "@/layouts/Layout.astro";
import { shouldRedirectRootToDashboard } from "@/lib/auth-navigation";

function redirect(path: string) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", path);
}

const shouldRedirect = shouldRedirectRootToDashboard(Astro.locals.user);

if (shouldRedirect) {
  redirect("/dashboard");
}
---

{
  !shouldRedirect && (
    <Layout>
      <Welcome />
    </Layout>
  )
}

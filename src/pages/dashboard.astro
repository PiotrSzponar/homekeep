---
import CreateTaskPanel from "@/components/tasks/CreateTaskPanel";
import TaskList from "@/components/tasks/TaskList.astro";
import Topbar from "@/components/Topbar.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import Layout from "@/layouts/Layout.astro";
import { toMaintenanceTaskDisplayItems, type MaintenanceTaskDisplayItem } from "@/lib/maintenance-tasks";
import { listMaintenanceTasks, type MaintenanceTaskSupabaseClient } from "@/lib/maintenance-task-store";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const taskCreated = Astro.url.searchParams.get("taskCreated") === "1";
const taskCompleted = Astro.url.searchParams.get("taskCompleted") === "1";
const taskDeleted = Astro.url.searchParams.get("taskDeleted") === "1";
const taskUpdated = Astro.url.searchParams.get("taskUpdated") === "1";
const taskError = Astro.url.searchParams.get("taskError");

let tasks: MaintenanceTaskDisplayItem[] = [];
let dashboardError: string | null = null;

if (supabase && user?.id) {
  const result = await listMaintenanceTasks(supabase as MaintenanceTaskSupabaseClient, user.id);

  if (result.error) {
    dashboardError = result.error.message;
  } else {
    tasks = toMaintenanceTaskDisplayItems(result.data);
  }
} else if (!supabase) {
  dashboardError = "Supabase is not configured.";
}
---

<Layout title="Dashboard">
  <main class="bg-background text-foreground min-h-screen">
    <Topbar />
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
      {
        taskCreated && (
          <Alert role="status">
            <AlertDescription>Task saved. The list below reflects the latest data from Supabase.</AlertDescription>
          </Alert>
        )
      }

      {
        taskCompleted && (
          <Alert role="status">
            <AlertDescription>
              Task marked completed. The list below reflects the latest data from Supabase.
            </AlertDescription>
          </Alert>
        )
      }

      {
        taskDeleted && (
          <Alert role="status">
            <AlertDescription>Task deleted. The list below reflects the latest data from Supabase.</AlertDescription>
          </Alert>
        )
      }

      {
        taskUpdated && (
          <Alert role="status">
            <AlertDescription>Task updated. The list below reflects the latest data from Supabase.</AlertDescription>
          </Alert>
        )
      }

      {
        taskError && (
          <Alert variant="destructive">
            <AlertDescription>{taskError}</AlertDescription>
          </Alert>
        )
      }

      {
        dashboardError && (
          <Alert role="status">
            <AlertDescription>{dashboardError}</AlertDescription>
          </Alert>
        )
      }

      <section class="grid gap-8 lg:grid-cols-[minmax(0,360px)_1fr] lg:items-start">
        <CreateTaskPanel hasTasks={tasks.length > 0} client:load />

        <TaskList tasks={tasks} />
      </section>
    </div>
  </main>
</Layout>

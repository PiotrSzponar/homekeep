---
import { CheckIcon, PencilIcon, TrashIcon } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from "@/components/ui/empty";
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field";
import { Input } from "@/components/ui/input";
import { Separator } from "@/components/ui/separator";
import type { MaintenanceTaskDisplayItem, MaintenanceTaskStatus } from "@/lib/maintenance-tasks";

interface Props {
  tasks: MaintenanceTaskDisplayItem[];
}

const { tasks } = Astro.props;

const statusLabels: Record<MaintenanceTaskStatus, string> = {
  ok: "OK",
  "due-soon": "Due soon",
  overdue: "Overdue",
};

const statusVariants: Record<MaintenanceTaskStatus, "default" | "secondary" | "destructive"> = {
  ok: "secondary",
  "due-soon": "default",
  overdue: "destructive",
};
---

<section class="min-w-0">
  <div class="mb-4 flex items-end justify-between gap-4">
    <div>
      <h2 class="text-foreground text-base font-semibold">Task list</h2>
      <p class="text-muted-foreground mt-1 text-sm">Sorted by urgency, then by next due date.</p>
    </div>
    <Badge variant="secondary">{tasks.length} saved</Badge>
  </div>

  {
    tasks.length === 0 ? (
      <Empty className="border border-border bg-card">
        <EmptyHeader>
          <EmptyMedia variant="icon">
            <PencilIcon aria-hidden="true" />
          </EmptyMedia>
          <EmptyTitle>No maintenance tasks yet</EmptyTitle>
          <EmptyDescription>Create one task to see its next due date and status here.</EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : (
      <ol class="grid gap-3">
        {tasks.map((task) => (
          <li id={`task-${task.id}`}>
            <Card size="sm">
              <CardHeader>
                <CardTitle className="truncate">{task.name}</CardTitle>
                <CardDescription>Repeats every {task.recurrenceIntervalDays} days</CardDescription>
                <CardAction>
                  <Badge variant={statusVariants[task.status]}>{statusLabels[task.status]}</Badge>
                </CardAction>
              </CardHeader>

              <CardContent>
                <dl class="grid gap-3 text-sm sm:grid-cols-3">
                  <div class="min-w-0">
                    <dt class="text-muted-foreground text-xs font-medium tracking-normal uppercase">Next due</dt>
                    <dd class="text-foreground mt-1 truncate">{task.nextDueDate}</dd>
                  </div>
                  <div class="min-w-0">
                    <dt class="text-muted-foreground text-xs font-medium tracking-normal uppercase">Last done</dt>
                    <dd class="text-foreground mt-1 truncate">{task.lastCompletedDate}</dd>
                  </div>
                  <div class="min-w-0">
                    <dt class="text-muted-foreground text-xs font-medium tracking-normal uppercase">Interval</dt>
                    <dd class="text-foreground mt-1 truncate">{task.recurrenceIntervalDays} days</dd>
                  </div>
                </dl>
              </CardContent>

              <CardFooter className="flex-col items-stretch gap-4">
                <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
                  <form method="POST" action="/api/tasks/complete">
                    <input type="hidden" name="taskId" value={task.id} />
                    <Button type="submit" variant="outline" size="sm" className="w-full sm:w-auto">
                      <CheckIcon data-icon="inline-start" aria-hidden="true" />
                      Mark completed
                    </Button>
                  </form>
                  <form
                    method="POST"
                    action="/api/tasks/delete"
                    onsubmit="return confirm('Delete this task permanently?')"
                  >
                    <input type="hidden" name="taskId" value={task.id} />
                    <Button type="submit" variant="destructive" size="sm" className="w-full sm:w-auto">
                      <TrashIcon data-icon="inline-start" aria-hidden="true" />
                      Delete
                    </Button>
                  </form>
                </div>

                <Separator />

                <details>
                  <summary
                    class:list={["cursor-pointer list-none", buttonVariants({ variant: "outline", size: "sm" })]}
                  >
                    <PencilIcon data-icon="inline-start" aria-hidden="true" />
                    Edit task
                  </summary>

                  <form method="POST" action="/api/tasks/update" class="mt-4">
                    <input type="hidden" name="taskId" value={task.id} />

                    <FieldGroup className="grid gap-4 sm:grid-cols-2">
                      <Field className="sm:col-span-2">
                        <FieldLabel htmlFor={`name-${task.id}`}>Task name</FieldLabel>
                        <Input id={`name-${task.id}`} name="name" value={task.name} required maxLength={120} />
                      </Field>

                      <Field>
                        <FieldLabel htmlFor={`last-completed-${task.id}`}>Last completed</FieldLabel>
                        <Input
                          id={`last-completed-${task.id}`}
                          type="date"
                          name="lastCompletedDate"
                          value={task.lastCompletedDate}
                          required
                        />
                      </Field>

                      <Field>
                        <FieldLabel htmlFor={`recurrence-${task.id}`}>Repeat every</FieldLabel>
                        <div class="flex items-center gap-2">
                          <Input
                            id={`recurrence-${task.id}`}
                            type="number"
                            name="recurrenceIntervalDays"
                            value={task.recurrenceIntervalDays}
                            required
                            min="1"
                            step="1"
                            inputMode="numeric"
                          />
                          <span class="text-muted-foreground text-sm">days</span>
                        </div>
                      </Field>
                    </FieldGroup>

                    <Button type="submit" size="sm" className="mt-4">
                      Save changes
                    </Button>
                  </form>
                </details>
              </CardFooter>
            </Card>
          </li>
        ))}
      </ol>
    )
  }
</section>

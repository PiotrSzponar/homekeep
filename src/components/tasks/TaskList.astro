---
import type { MaintenanceTaskDisplayItem, MaintenanceTaskStatus } from "@/lib/maintenance-tasks";

interface Props {
  tasks: MaintenanceTaskDisplayItem[];
}

const { tasks } = Astro.props;

const statusLabels: Record<MaintenanceTaskStatus, string> = {
  ok: "OK",
  "due-soon": "Due soon",
  overdue: "Overdue",
};

const statusClasses: Record<MaintenanceTaskStatus, string> = {
  ok: "border-sky-400/30 bg-sky-400/10 text-sky-100",
  "due-soon": "border-amber-400/30 bg-amber-400/10 text-amber-100",
  overdue: "border-rose-400/30 bg-rose-400/10 text-rose-100",
};
---

<section class="min-w-0">
  <div class="mb-4 flex items-end justify-between gap-4">
    <div>
      <h2 class="text-base font-semibold text-white">Task list</h2>
      <p class="mt-1 text-sm text-slate-400">Sorted by urgency, then by next due date.</p>
    </div>
    <span class="text-sm text-slate-400">{tasks.length} saved</span>
  </div>

  {
    tasks.length === 0 ? (
      <div class="rounded-md border border-dashed border-slate-700 bg-slate-900/40 px-5 py-8 text-center">
        <h3 class="text-base font-semibold text-white">No maintenance tasks yet</h3>
        <p class="mt-2 text-sm text-slate-400">Create one task to see its next due date and status here.</p>
      </div>
    ) : (
      <ol class="grid gap-3">
        {tasks.map((task) => (
          <li class="rounded-md border border-slate-800 bg-slate-900/70 p-4" id={`task-${task.id}`}>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0">
                <h3 class="truncate text-base font-semibold text-white">{task.name}</h3>
                <dl class="mt-3 grid gap-3 text-sm text-slate-300 sm:grid-cols-3">
                  <div>
                    <dt class="text-xs font-medium tracking-normal text-slate-500 uppercase">Next due</dt>
                    <dd class="mt-1 text-white">{task.nextDueDate}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-medium tracking-normal text-slate-500 uppercase">Last done</dt>
                    <dd class="mt-1">{task.lastCompletedDate}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-medium tracking-normal text-slate-500 uppercase">Repeats</dt>
                    <dd class="mt-1">{task.recurrenceIntervalDays} days</dd>
                  </div>
                </dl>
              </div>
              <div class="flex shrink-0 flex-col items-start gap-2 sm:items-end">
                <span
                  class:list={[
                    "inline-flex w-fit items-center rounded-md border px-2.5 py-1 text-xs font-semibold",
                    statusClasses[task.status],
                  ]}
                >
                  {statusLabels[task.status]}
                </span>
                <form method="POST" action="/api/tasks/complete">
                  <input type="hidden" name="taskId" value={task.id} />
                  <button
                    type="submit"
                    class="inline-flex h-9 items-center justify-center rounded-md border border-emerald-500/40 px-3 text-sm font-medium text-emerald-100 transition-colors hover:bg-emerald-500/10 focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900 focus:outline-none"
                  >
                    Mark completed
                  </button>
                </form>
              </div>
            </div>

            <details class="mt-4 border-t border-slate-800 pt-4">
              <summary class="inline-flex h-9 cursor-pointer list-none items-center justify-center rounded-md border border-slate-700 px-3 text-sm font-medium text-slate-100 transition-colors select-none hover:bg-slate-900 focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 focus:ring-offset-slate-900 focus:outline-none">
                Edit task
              </summary>

              <form method="POST" action="/api/tasks/update" class="mt-4 grid gap-4 sm:grid-cols-2">
                <input type="hidden" name="taskId" value={task.id} />

                <label class="flex flex-col gap-2 text-sm font-medium text-slate-200 sm:col-span-2">
                  Task name
                  <input
                    name="name"
                    value={task.name}
                    required
                    maxlength="120"
                    class="h-10 rounded-md border border-slate-700 bg-slate-950 px-3 text-sm text-white transition-colors focus:border-emerald-400 focus:outline-none"
                  />
                </label>

                <label class="flex flex-col gap-2 text-sm font-medium text-slate-200">
                  Last completed
                  <input
                    type="date"
                    name="lastCompletedDate"
                    value={task.lastCompletedDate}
                    required
                    class="h-10 rounded-md border border-slate-700 bg-slate-950 px-3 text-sm text-white transition-colors focus:border-emerald-400 focus:outline-none"
                  />
                </label>

                <label class="flex flex-col gap-2 text-sm font-medium text-slate-200">
                  Repeat every
                  <div class="flex items-center gap-2">
                    <input
                      type="number"
                      name="recurrenceIntervalDays"
                      value={task.recurrenceIntervalDays}
                      required
                      min="1"
                      step="1"
                      inputmode="numeric"
                      class="h-10 min-w-0 flex-1 rounded-md border border-slate-700 bg-slate-950 px-3 text-sm text-white transition-colors focus:border-emerald-400 focus:outline-none"
                    />
                    <span class="text-sm text-slate-400">days</span>
                  </div>
                </label>

                <div class="sm:col-span-2">
                  <button
                    type="submit"
                    class="inline-flex h-9 items-center justify-center rounded-md bg-emerald-500 px-3 text-sm font-medium text-slate-950 transition-colors hover:bg-emerald-400 focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900 focus:outline-none"
                  >
                    Save changes
                  </button>
                </div>
              </form>
            </details>
          </li>
        ))}
      </ol>
    )
  }
</section>

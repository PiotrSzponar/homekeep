---
import type { MaintenanceTaskDisplayItem, MaintenanceTaskStatus } from "@/lib/maintenance-tasks";

interface Props {
  tasks: MaintenanceTaskDisplayItem[];
}

const { tasks } = Astro.props;

const statusLabels: Record<MaintenanceTaskStatus, string> = {
  ok: "OK",
  "due-soon": "Due soon",
  overdue: "Overdue",
};

const statusClasses: Record<MaintenanceTaskStatus, string> = {
  ok: "border-sky-400/30 bg-sky-400/10 text-sky-100",
  "due-soon": "border-amber-400/30 bg-amber-400/10 text-amber-100",
  overdue: "border-rose-400/30 bg-rose-400/10 text-rose-100",
};
---

<section class="min-w-0">
  <div class="mb-4 flex items-end justify-between gap-4">
    <div>
      <h2 class="text-base font-semibold text-white">Task list</h2>
      <p class="mt-1 text-sm text-slate-400">Sorted by urgency, then by next due date.</p>
    </div>
    <span class="text-sm text-slate-400">{tasks.length} saved</span>
  </div>

  {
    tasks.length === 0 ? (
      <div class="rounded-md border border-dashed border-slate-700 bg-slate-900/40 px-5 py-8 text-center">
        <h3 class="text-base font-semibold text-white">No maintenance tasks yet</h3>
        <p class="mt-2 text-sm text-slate-400">Create one task to see its next due date and status here.</p>
      </div>
    ) : (
      <ol class="grid gap-3">
        {tasks.map((task) => (
          <li class="rounded-md border border-slate-800 bg-slate-900/70 p-4" id={`task-${task.id}`}>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0">
                <h3 class="truncate text-base font-semibold text-white">{task.name}</h3>
                <dl class="mt-3 grid gap-3 text-sm text-slate-300 sm:grid-cols-3">
                  <div>
                    <dt class="text-xs font-medium tracking-normal text-slate-500 uppercase">Next due</dt>
                    <dd class="mt-1 text-white">{task.nextDueDate}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-medium tracking-normal text-slate-500 uppercase">Last done</dt>
                    <dd class="mt-1">{task.lastCompletedDate}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-medium tracking-normal text-slate-500 uppercase">Repeats</dt>
                    <dd class="mt-1">{task.recurrenceIntervalDays} days</dd>
                  </div>
                </dl>
              </div>
              <div class="flex shrink-0 flex-col items-start gap-2 sm:items-end">
                <span
                  class:list={[
                    "inline-flex w-fit items-center rounded-md border px-2.5 py-1 text-xs font-semibold",
                    statusClasses[task.status],
                  ]}
                >
                  {statusLabels[task.status]}
                </span>
                <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:justify-end">
                  <form method="POST" action="/api/tasks/complete">
                    <input type="hidden" name="taskId" value={task.id} />
                    <button
                      type="submit"
                      class="inline-flex h-9 w-full items-center justify-center rounded-md border border-emerald-500/40 px-3 text-sm font-medium text-emerald-100 transition-colors hover:bg-emerald-500/10 focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900 focus:outline-none sm:w-auto"
                    >
                      Mark completed
                    </button>
                  </form>
                  <form
                    method="POST"
                    action="/api/tasks/delete"
                    onsubmit="return confirm('Delete this task permanently?')"
                  >
                    <input type="hidden" name="taskId" value={task.id} />
                    <button
                      type="submit"
                      class="inline-flex h-9 w-full items-center justify-center rounded-md border border-rose-500/40 px-3 text-sm font-medium text-rose-100 transition-colors hover:bg-rose-500/10 focus:ring-2 focus:ring-rose-400 focus:ring-offset-2 focus:ring-offset-slate-900 focus:outline-none sm:w-auto"
                    >
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    )
  }
</section>

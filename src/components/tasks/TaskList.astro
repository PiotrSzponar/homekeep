---
import { PencilIcon } from "lucide-react";
import TaskActions from "@/components/tasks/TaskActions";
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from "@/components/ui/empty";
import { Separator } from "@/components/ui/separator";
import type { MaintenanceTaskDisplayItem, MaintenanceTaskStatus } from "@/lib/maintenance-tasks";

interface Props {
  tasks: MaintenanceTaskDisplayItem[];
}

const { tasks } = Astro.props;

const statusLabels: Record<MaintenanceTaskStatus, string> = {
  ok: "OK",
  "due-soon": "Due soon",
  overdue: "Overdue",
};

const statusVariants: Record<MaintenanceTaskStatus, "default" | "secondary" | "destructive"> = {
  ok: "outline",
  "due-soon": "secondary",
  overdue: "destructive",
};
---

<section class="min-w-0">
  <div class="mb-4 flex items-end justify-between gap-4">
    <div>
      <h2 class="text-foreground text-base font-semibold">Task list</h2>
      <p class="text-muted-foreground mt-1 text-sm">Sorted by urgency, then by next due date.</p>
    </div>
    <Badge variant="secondary">{tasks.length} saved</Badge>
  </div>

  {
    tasks.length === 0 ? (
      <Empty className="border border-border bg-card">
        <EmptyHeader>
          <EmptyMedia variant="icon">
            <PencilIcon aria-hidden="true" />
          </EmptyMedia>
          <EmptyTitle>No maintenance tasks yet</EmptyTitle>
          <EmptyDescription>Create one task to see its next due date and status here.</EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : (
      <ol class="grid gap-3">
        {tasks.map((task) => (
          <li id={`task-${task.id}`}>
            <Card size="sm">
              <CardHeader>
                <CardTitle className="truncate">{task.name}</CardTitle>
                <CardDescription>Repeats every {task.recurrenceIntervalDays} days</CardDescription>
                <CardAction>
                  <Badge variant={statusVariants[task.status]}>{statusLabels[task.status]}</Badge>
                </CardAction>
              </CardHeader>

              <CardContent>
                <dl class="grid gap-3 text-sm sm:grid-cols-2">
                  <div class="min-w-0">
                    <dt class="text-muted-foreground text-xs font-medium tracking-normal uppercase">Next due</dt>
                    <dd class="text-foreground mt-1 truncate">{task.nextDueDate}</dd>
                  </div>
                  <div class="min-w-0">
                    <dt class="text-muted-foreground text-xs font-medium tracking-normal uppercase">Last completed</dt>
                    <dd class="text-foreground mt-1 truncate">{task.lastCompletedDate}</dd>
                  </div>
                </dl>
              </CardContent>

              <CardFooter className="flex-col items-stretch gap-4">
                <Separator />
                <TaskActions task={task} client:load />
              </CardFooter>
            </Card>
          </li>
        ))}
      </ol>
    )
  }
</section>

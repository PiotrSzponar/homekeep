---
import Topbar from "@/components/Topbar.astro";
interface Props {
  mainClass?: string;
}

const { mainClass } = Astro.props;
---

<div class="bg-background text-foreground min-h-screen">
  <Topbar />
  <main class:list={["mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8", mainClass]}>
    <slot />
  </main>
</div>

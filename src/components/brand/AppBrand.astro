---
import HomeKeepMark from "@/components/brand/HomeKeepMark.astro";
import { HOMEKEEP_BRAND } from "@/lib/brand";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class="text-foreground inline-flex min-w-0 items-center gap-2 no-underline" href="/">
  <HomeKeepMark class="size-8 shrink-0" />
  <span class="min-w-0">
    <span class="block truncate text-sm leading-none font-semibold">{HOMEKEEP_BRAND.name}</span>
    {!compact && <span class="text-muted-foreground mt-1 block truncate text-xs">{HOMEKEEP_BRAND.tagline}</span>}
  </span>
</a>

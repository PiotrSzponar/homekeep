---
import AppBrand from "@/components/brand/AppBrand.astro";
import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import { ThemeToggle } from "@/components/ui/theme-toggle";

const { user } = Astro.locals;
---

<header class="border-border bg-background/95 sticky top-0 z-10 border-b">
  <div class="mx-auto flex min-h-16 w-full max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <AppBrand />
    <ThemeToggle client:load />

    {
      user ? (
        <div class="ml-auto flex min-w-0 items-center gap-3">
          <Badge variant="secondary" className="hidden max-w-56 truncate sm:inline-flex">
            {user.email}
          </Badge>
          <form method="POST" action="/api/auth/signout">
            <Button type="submit" variant="ghost" size="sm">
              Sign out
            </Button>
          </form>
        </div>
      ) : (
        <div class="ml-auto flex items-center gap-2">
          <a href="/auth/signin" class:list={[buttonVariants({ variant: "default", size: "sm" })]}>
            Sign in
          </a>
        </div>
      )
    }
  </div>
</header>
